QWidget {
    font-family: ${fontStack_system};
    color: #2b2b2b;
    background-color: #ffffff;
}


/* Menu Bar */
QMenuBar {
    font-size: 14px;
    background-color: #f5f5f5;
    color: #000000;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e6e6e6;
    color: #000000;
}

/* Buttons */
QPushButton {
    background-color: #e6e6e6;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px 12px;
    color: #000000;
}

QPushButton:hover {
    background-color: #dcdcdc;
}

/* Cards */
QWidget[class="card"] {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 8px;
    padding: 10px;
}

/* Tables */
QTableView {
    background-color: #ffffff;
    color: #000000;
    gridline-color: #d1d1d1;
    border: 1px solid #d1d1d1;
}