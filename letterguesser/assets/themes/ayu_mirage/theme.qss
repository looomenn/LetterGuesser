/* Ayu Mirage Theme */

QWidget {
    background-color: #1F2430;
    color: #CBCCC6;
    font-family: ${fontStack_system};
}

QPushButton {
    background-color: #343B4B;
    color: #CBCCC6;
    border: 1px solid #3E4B59;
    padding: 5px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #3E4B59;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2B3244;
    color: #CBCCC6;
    border: 1px solid #3E4B59;
}

QLabel {
    color: #CBCCC6;
}

QMenuBar {
    background-color: #1F2430;
    color: #CBCCC6;
}

QMenuBar::item:selected {
    background-color: #343B4B;
}

QMenu {
    background-color: #1F2430;
    color: #CBCCC6;
}

QMenu::item:selected {
    background-color: #343B4B;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #1F2430;
    width: 15px;
    height: 15px;
}

QScrollBar::handle {
    background-color: #343B4B;
    border: 1px solid #3E4B59;
}

QComboBox {
    background-color: #2B3244;
    color: #CBCCC6;
    border: 1px solid #3E4B59;
}

QComboBox QAbstractItemView {
    background-color: #2B3244;
    color: #CBCCC6;
    selection-background-color: #343B4B;
}
