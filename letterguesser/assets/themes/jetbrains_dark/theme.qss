QWidget {
    background-color: #2b2b2b;
    color: #a9b7c6;
    font-family: ${fontStack_system};
}

QLabel {
    color: #a9b7c6;
}

QPushButton {
    background-color: #3c3f41;
    color: #a9b7c6;
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #4c5052;
}

QPushButton:disabled {
    background-color: #2e2e2e;
    color: #6d6d6d;
}

QMenuBar {
    background-color: #3c3f41;
    color: #a9b7c6;
}

QMenu {
    background-color: #3c3f41;
    color: #a9b7c6;
}

QMenu::item:selected {
    background-color: #4c5052;
}
