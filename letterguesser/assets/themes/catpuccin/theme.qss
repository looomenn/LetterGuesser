/* Catppuccin Theme */

QWidget {
    background-color: #1E1E2E;
    color: #D9E0EE;
    font-family: ${fontStack_system};
}

/* Button Styling */
QPushButton {
    background-color: #302D41;
    color: #D9E0EE;
    border: 1px solid #575268;
    padding: 5px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #575268;
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #26233A;
    color: #D9E0EE;
    border: 1px solid #575268;
}

/* Labels */
QLabel {
    color: #D9E0EE;
}

/* Menu Bar Styling */
QMenuBar {
    background-color: #1E1E2E;
    color: #D9E0EE;
}

QMenuBar::item {
    background-color: #1E1E2E;
    color: #D9E0EE;
    font-size: 10pt;
}

QMenuBar::item:selected {
    background-color: #302D41;
    color: #D9E0EE;
    font-size: 10pt;
}

/* Menu Styling */
QMenu {
    background-color: #1E1E2E;
    color: #D9E0EE;
}

QMenu::item {
    background-color: #1E1E2E;
    color: #D9E0EE;
    font-size: 10pt;
}

QMenu::item:selected {
    background-color: #302D41;
    color: #D9E0EE;
    font-size: 10pt;
}

/* Scroll Bars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #1E1E2E;
    width: 15px;
    height: 15px;
}

QScrollBar::handle {
    background-color: #302D41;
    border: 1px solid #575268;
}

/* Combo Boxes */
QComboBox {
    background-color: #26233A;
    color: #D9E0EE;
    border: 1px solid #575268;
}

QComboBox QAbstractItemView {
    background-color: #26233A;
    color: #D9E0EE;
    selection-background-color: #302D41;
}
